<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained single-file release build:
     dotnet publish src\FileDock\FileDock.csproj -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF ships native libraries; bundle them so the release is one file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression would shrink the exe from ~148 MB to ~66 MB, but compressed assemblies are
         unpacked into private memory at startup: measured 145 MB private vs 68 MB uncompressed,
         and slower startup. FileDock runs all day, so memory wins. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>

<Window x:Class="FileDock.Views.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileDock.ViewModels"
        Title="FileDock"
        Width="340" Height="480" Left="-32000" Top="-32000"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowDrop="True"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="FileDock shelf">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Six-dot grip used on the drag-all strip. -->
        <GeometryGroup x:Key="GripDots">
            <EllipseGeometry Center="1.25,1.25" RadiusX="1.25" RadiusY="1.25" />
            <EllipseGeometry Center="5.75,1.25" RadiusX="1.25" RadiusY="1.25" />
            <EllipseGeometry Center="1.25,6" RadiusX="1.25" RadiusY="1.25" />
            <EllipseGeometry Center="5.75,6" RadiusX="1.25" RadiusY="1.25" />
            <EllipseGeometry Center="1.25,10.75" RadiusX="1.25" RadiusY="1.25" />
            <EllipseGeometry Center="5.75,10.75" RadiusX="1.25" RadiusY="1.25" />
        </GeometryGroup>

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid Height="46" Background="Transparent" ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="800">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="20" Height="20" VerticalAlignment="Center">
                    <Image x:Name="Icon" Source="{Binding Icon}" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border x:Name="Warning" Visibility="Collapsed" Width="12" Height="12" CornerRadius="6"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                            Background="{DynamicResource Brush.Panel}">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{DynamicResource Brush.Error}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsText" Text="{Binding Details}" FontSize="11.5" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>

                <Button x:Name="RemoveButton" Grid.Column="2" Visibility="Hidden" Focusable="False"
                        Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="9" Content="&#xE8BB;"
                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}"
                        ToolTip="Remove from shelf (the file is not deleted)"
                        AutomationProperties.Name="Remove from shelf" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Warning" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                    <Setter TargetName="DetailsText" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ============ Expanded panel ============ -->
        <Border x:Name="PanelRoot" Visibility="Hidden" BorderThickness="1,1,0,1"
                BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Panel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Margin="16,0,8,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="PinButton" IsChecked="{Binding IsPinned, Mode=TwoWay}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButton}">
                                    <Setter Property="Content" Value="&#xE718;" />
                                    <Setter Property="ToolTip" Value="Pin open" />
                                    <Setter Property="AutomationProperties.Name" Value="Pin open" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content" Value="&#xE840;" />
                                            <Setter Property="ToolTip" Value="Unpin" />
                                            <Setter Property="AutomationProperties.Name" Value="Unpin" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="2,0,0,0"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Settings" AutomationProperties.Name="Settings" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="FileDock" FontWeight="SemiBold" />
                        <Run Text="  " />
                        <Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </TextBlock>
                </DockPanel>

                <!-- Drag-all strip: a real OLE drag source for every staged item. -->
                <Border x:Name="DragAllStrip" Grid.Row="1" Margin="10,0,10,8" Height="40" CornerRadius="5" BorderThickness="1"
                        Focusable="False"
                        ToolTip="Drag into a folder, an email or another app. The files are copied; the originals stay where they are."
                        AutomationProperties.Name="{Binding DragAllText}"
                        MouseLeftButtonDown="OnDragAllMouseDown" MouseMove="OnDragAllMouseMove"
                        MouseLeftButtonUp="OnDragAllMouseUp" LostMouseCapture="OnDragAllLostCapture">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Separator}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel Margin="13,0,12,0">
                        <Path Data="{StaticResource GripDots}" Fill="{DynamicResource Brush.TextSecondary}"
                              Width="7" Height="12" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DragAllText}" Margin="12,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <!-- List, empty state and drop overlay share this cell. -->
                <Grid Grid.Row="2">
                    <ListBox x:Name="ItemsList" ItemsSource="{Binding Items}" SelectionMode="Extended"
                             ItemTemplate="{StaticResource ItemTemplate}" ItemContainerStyle="{StaticResource RowItem}"
                             Background="Transparent" BorderThickness="0" Padding="0" Focusable="True" FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             AutomationProperties.Name="Items on the shelf"
                             PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                             PreviewMouseLeftButtonUp="OnListMouseUp" SelectionChanged="OnSelectionChanged"
                             ContextMenuOpening="OnListContextMenuOpening">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}" />
                        </ListBox.Resources>
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Focusable="False" Padding="0,0,0,6" CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="OnMenuOpened" Closed="OnMenuClosed">
                                <MenuItem Header="Open" Command="{Binding OpenCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Show in folder" Command="{Binding RevealCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Copy path" Command="{Binding CopyPathCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Remove from shelf" InputGestureText="Del" Command="{Binding RemoveSelectedCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <StackPanel Margin="36,0,36,36" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                        <TextBlock Text="Drop files here" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Collect files from different folders, then drag them out together."
                                   Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,6,0,0" LineHeight="18" />
                    </StackPanel>

                    <Border Margin="10,0,10,8" CornerRadius="6" BorderThickness="1.5" IsHitTestVisible="False"
                            Background="{DynamicResource Brush.Overlay}"
                            Visibility="{Binding IsDropOverlayVisible, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DropAllowed}" Value="False">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextDisabled}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" Margin="28,0">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE896;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DropAllowed}" Value="False">
                                                <Setter Property="Text" Value="&#xE711;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding DropTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DropDetail}" Foreground="{DynamicResource Brush.TextSecondary}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Notice line (added, removed + undo, errors) -->
                <Border Grid.Row="3" Margin="10,0,10,8" Padding="12,6,6,6" CornerRadius="5" MinHeight="36"
                        Background="{DynamicResource Brush.Hover}"
                        Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="9"
                                Content="&#xE8BB;" Command="{Binding DismissNoticeCommand}"
                                ToolTip="Dismiss" AutomationProperties.Name="Dismiss message"
                                Visibility="{Binding NoticeIsSticky, Converter={StaticResource BoolToVis}}" />
                        <Button DockPanel.Dock="Right" Content="{Binding NoticeActionText}" Command="{Binding NoticeActionCommand}"
                                VerticalAlignment="Center" Margin="6,0,0,0"
                                AutomationProperties.Name="{Binding NoticeActionText}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoticeActionText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Margin="0,1,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Error}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoticeKind}" Value="{x:Static vm:NoticeKind.Error}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Separator}" Padding="16,6,8,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource TextButton}" Content="Remove"
                                    Command="{Binding RemoveSelectedCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=ItemsList}"
                                    ToolTip="Remove the selected items from the shelf (Delete). Files are not deleted." />
                            <Button Style="{StaticResource TextButton}" Content="Clear" Margin="2,0,0,0"
                                    Command="{Binding ClearCommand}"
                                    ToolTip="Remove everything from the shelf. Files are not deleted." />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Collapsed handle ============ -->
        <Border x:Name="HandleView" Width="10" Height="64" HorizontalAlignment="Right" VerticalAlignment="Top"
                BorderThickness="1,1,0,1" Background="{DynamicResource Brush.Handle}"
                BorderBrush="{DynamicResource Brush.HandleBorder}"
                MouseEnter="OnHandleMouseEnter" MouseLeave="OnHandleMouseLeave"
                AutomationProperties.Name="FileDock. Point here or drag files here to open the shelf.">
            <Border Width="2" Height="24" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.HandleGrip}" />
                        <Style.Triggers>
                            <!-- The grip takes the accent colour when the shelf holds items. -->
                            <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=HandleView}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Text}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Border>
    </Grid>
</Window>
